    "durable_authority": "sovereign-state StateStore / SQLite WAL remains the only canonical store; sovereign-memory owns lifecycle semantics and never opens a second database authority",
    "state_schema_version": 4,
    "migration": "crates/sovereign-state/migrations/0004_memory.sql",
    "schema_manifest": "schemas/memory-record-v1.json",
    "memory_classes": [
      "governed_knowledge",
      "validated_project_fact",
      "episodic",
      "procedural_candidate",
      "preference_context"
    ],
    "scope": "uniform project/agent/shared-within-project envelope plus explicit role visibility",
    "provenance": "source evidence IDs, producing task/attempt, repository/revision, exact source fingerprints, confidence, trust, version, expiry and invalidation predicates",
    "conflict_semantics": "same-scope equal-trust incompatible assertions create durable conflict sets; governed contradictions require explicit supersession; lower-trust contradictions remain auditable but are excluded from normal injection",
    "freshness_semantics": "repository fingerprint/revision delta is applied before lifecycle injection eligibility; affected active records become stale without deleting provenance",
    "retention_semantics": "stale/superseded/deprecated/expired/archived and unresolved conflicted records are excluded from ordinary injection; records and conflict sets are delete-protected durable provenance"
  },
