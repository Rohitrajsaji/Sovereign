  "implementation": {
    "canonical_authority": "sovereign-plan exposes the single M1 PlanCompiler. It creates validated immutable candidates only; it has no plan-activation or tool-authorization surface.",
    "bounded_inputs": "PlanCompilationInput consumes a bounded ContextPacket and exact source handles produced by M1-T06 rather than full repository or chat history.",
    "provider_neutrality": "PlanCompiler calls only dyn ModelBackend::complete. Provider-specific rendering/tokenization/admission stays inside the model backend and is observed only by the test-only real-model qualification harness.",
    "outer_budget": "Every proposal call, including the one bounded malformed-proposal retry, consumes the caller-owned ModelCallBudget before provider dispatch.",
    "deterministic_normalization": "A simple proposal becomes one task; a two-task short-linear Plan IR is permitted only when explicit evidence queries justify the split. PlanValidator must pass before a PlanCompilationResult exists.",
    "authority_non_widening": "Role, skill, tool and evaluator identities are caller-supplied pinned values. Model output cannot replace them, grant permissions, activate a plan, or authorize an action. Unknown paths become explicit evidence requirements.",
    "eval_harness_scope": "sovereign-eval is materialized early only as the frozen M1 test/fixture harness required by roadmap verification commands; it exposes no M2 telemetry or production evaluation API."
  },
