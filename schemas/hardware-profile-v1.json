{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sovereign://schemas/hardware-profile-v1.json",
  "title": "Sovereign HardwareProfile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "physical_memory_mib",
    "logical_cpus",
    "normal_model_slots",
    "mutating_task_slots",
    "browser_slots",
    "embedder_slots",
    "heavy_build_slots",
    "heavy_index_slots",
    "minimum_host_free_disk_mib",
    "sovereign_disk_soft_limit_mib",
    "sovereign_disk_hard_limit_mib",
    "normal_controlled_working_set_soft_mib",
    "normal_controlled_working_set_hard_mib",
    "minimum_launch_headroom_soft_mib",
    "minimum_launch_headroom_hard_mib",
    "default_model_input_tokens",
    "default_model_output_reserve_tokens",
    "hard_model_input_tokens_without_profile_override",
    "guarded_growth_mib_per_min",
    "constrained_growth_mib_per_min",
    "constrained_controlled_working_set_mib",
    "heavy_lease_recovery_green_seconds",
    "heavy_lease_reload_cooldown_seconds",
    "heavy_lease_oscillation_window_seconds",
    "max_completed_eviction_cycles_per_window",
    "unknown_heavy_admission_mib",
    "unknown_heavy_first_run_max_jobs",
    "calibrated_build_max_jobs",
    "unknown_heavy_first_run_max_subprocesses",
    "pair_rules"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "physical_memory_mib": { "type": "integer", "minimum": 1 },
    "logical_cpus": { "type": "integer", "minimum": 1 },
    "normal_model_slots": { "type": "integer", "minimum": 1 },
    "mutating_task_slots": { "type": "integer", "minimum": 1 },
    "browser_slots": { "type": "integer", "minimum": 1 },
    "embedder_slots": { "type": "integer", "minimum": 1 },
    "heavy_build_slots": { "type": "integer", "minimum": 1 },
    "heavy_index_slots": { "type": "integer", "minimum": 1 },
    "minimum_host_free_disk_mib": { "type": "integer", "minimum": 0 },
    "sovereign_disk_soft_limit_mib": { "type": "integer", "minimum": 0 },
    "sovereign_disk_hard_limit_mib": { "type": "integer", "minimum": 0 },
    "normal_controlled_working_set_soft_mib": { "type": "integer", "minimum": 1 },
    "normal_controlled_working_set_hard_mib": { "type": "integer", "minimum": 1 },
    "minimum_launch_headroom_soft_mib": { "type": "integer", "minimum": 1 },
    "minimum_launch_headroom_hard_mib": { "type": "integer", "minimum": 1 },
    "default_model_input_tokens": { "type": "integer", "minimum": 1 },
    "default_model_output_reserve_tokens": { "type": "integer", "minimum": 1 },
    "hard_model_input_tokens_without_profile_override": { "type": "integer", "minimum": 1 },
    "guarded_growth_mib_per_min": { "type": "integer", "minimum": 0 },
    "constrained_growth_mib_per_min": { "type": "integer", "minimum": 0 },
    "constrained_controlled_working_set_mib": { "type": "integer", "minimum": 1 },
    "heavy_lease_recovery_green_seconds": { "type": "integer", "minimum": 0 },
    "heavy_lease_reload_cooldown_seconds": { "type": "integer", "minimum": 0 },
    "heavy_lease_oscillation_window_seconds": { "type": "integer", "minimum": 1 },
    "max_completed_eviction_cycles_per_window": { "type": "integer", "minimum": 0 },
    "unknown_heavy_admission_mib": { "type": "integer", "minimum": 1 },
    "unknown_heavy_first_run_max_jobs": { "type": "integer", "minimum": 1 },
    "calibrated_build_max_jobs": { "type": "integer", "minimum": 1 },
    "unknown_heavy_first_run_max_subprocesses": { "type": "integer", "minimum": 1 },
    "pair_rules": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": { "$ref": "#/$defs/pair_rule" }
    }
  },
  "$defs": {
    "heavy_class": {
      "enum": [
        "MODEL",
        "EMBEDDER",
        "CDP_BROWSER",
        "ADAPTIVE_BROWSER",
        "BUILD_HEAVY",
        "INDEXER",
        "CODEGRAPH_WIKI",
        "LSP",
        "UNKNOWN"
      ]
    },
    "pair_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "requested", "rule"],
      "properties": {
        "active": { "$ref": "#/$defs/heavy_class" },
        "requested": { "$ref": "#/$defs/heavy_class" },
        "rule": { "enum": ["SAFE", "CONDITIONAL", "SERIALIZE", "FORBIDDEN"] }
      }
    }
  }
}
